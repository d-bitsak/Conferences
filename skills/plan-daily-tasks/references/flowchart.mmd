flowchart TD
    SETUP["Первый запуск или продолжение настройки"] --> BOOT["Проверить личную привязку и прогресс"]
    BOOT --> CAPS["Проверить нужные источники; уточнить недостающее"]
    CAPS --> PREVIEW["Пробный список и выбор без изменения карточек"]
    PREVIEW --> SAVESET["Сохранить личные настройки, карты и bootstrap"]
    SAVESET --> OPTIONS["Включить только выбранные проверенные дополнения"]
    OPTIONS --> CARD["Карточка готовности или конкретная блокировка"]

    A["Запрос планирования дня"] --> B["Локальная дата и настройки источников"]
    B --> C["Свежие личные задачи; все страницы и реальные статусы"]
    C --> D{"Чтение полное?"}
    D -->|"Нет"| E["Отметить доступную часть и пробелы"]
    D -->|"Да"| F{"Есть доступные кандидаты?"}
    E --> F
    F -->|"Нет"| Z["Итог без вопроса; отличить ноль от неполноты"]
    F -->|"Да"| G["Сквозной список и неизменная карта номеров"]
    G --> H["Какие задачи берём на сегодня?"]
    H --> I["Ответ по исходному списку"]
    I --> J{"Дата и выбор однозначны?"}
    J -->|"Нет"| K["Один вопрос по неясному"]
    K --> L{"Есть подтверждённая часть?"}
    L -->|"Нет"| I
    L -->|"Да"| M["Подтверждённая часть фокуса"]
    J -->|"Да"| M
    M --> N["Перечитать выбранные карточки"]
    N --> O{"Изменение разрешено и mapping известен?"}
    O -->|"Нет"| P["Выбор сохранён; карточка не изменена"]
    O -->|"Да"| Q{"Карточка уже в нужном состоянии?"}
    Q -->|"Да"| R["Без повторного изменения"]
    Q -->|"Нет"| RES{"Резерв операции подтверждён?"}
    RES -->|"Нет"| WAITWRITE["Фокус доступен; изменение ожидает сверки"]
    WAITWRITE --> W
    RES -->|"Да"| S["Выполнить разрешённую операцию"]
    S --> T{"Исход подтверждён?"}
    T -->|"Нет"| U["Сверить прежний исход без слепого повтора"]
    T -->|"Да"| V["Сохранить фактический результат"]
    U --> V
    P --> W["Датированный фокус отдельно от утреннего состояния"]
    R --> W
    V --> W
    W --> X["Выбранный календарь; экземпляры, изменения и пробелы"]
    X --> Y["Подготовка по фактам; рекомендации отдельно"]
    Y --> AA["Отдельное сообщение: фокус и встречи сегодня"]
    AA --> AB["Содержание задач автоматически не выполнять"]

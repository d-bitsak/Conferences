flowchart TD
    START["Файл пользователя или уведомление источника"] --> CONFIG["Прочитать режим, настройки и журнал"]
    RETRY["Повтор только открытой очереди"] --> CONFIG
    CONFIG --> SOURCE["Проверить экземпляр, доступ и область"]
    SOURCE --> FULL["Получить полный доступный транскрипт"]
    FULL --> READY{"Материалы готовы?"}
    READY -->|"Нет"| WAIT["waiting_assets или конкретный blocked"]
    WAIT -.-> RETRY
    READY -->|"Да"| ANALYZE["Основной анализ полного текста"]
    ANALYZE --> OUTPUT["Итоги, решения, действия и TXT"]
    OUTPUT --> MODE{"Разрешены внешние действия?"}
    MODE -->|"Нет"| REVIEW["REVIEW: результат владельцу"]
    MODE -->|"Да"| ROUTES["Выбрать настроенные направления"]
    subgraph CHANNELS["Независимые направления"]
        ROUTES --> EMAIL["Письмо приглашённым"]
        ROUTES --> CHAT["Личный чат владельца"]
        ROUTES --> TASKS["Собственные задачи"]
        ROUTES --> API["API кратких итогов"]
        ROUTES --> ARCHIVE["Архив"]
    end
    EMAIL --> CHECK
    CHAT --> CHECK
    TASKS --> CHECK
    API --> CHECK
    ARCHIVE --> CHECK
    CHECK{"Права, данные и история проверены?"}
    CHECK -->|"Блокировка"| BLOCKED["Остановить только затронутую ветку"]
    CHECK -->|"Нужна сверка"| RECOVER["Проверить прежнюю попытку по ID"]
    CHECK -->|"Подтверждённый дубль"| SKIP["Не повторять действие"]
    CHECK -->|"Новое разрешённое действие"| RESERVE{"Резервация сохранена?"}
    RESERVE -->|"Конфликт"| RELOAD["Перечитать журнал"]
    RELOAD --> CHECK
    RESERVE -->|"Да"| ACTION["Выполнить минимальный вызов"]
    ACTION --> SAVE["Сохранить исход и ID"]
    SAVE --> VERIFY["Проверить результат по правилам ветки"]
    SAVE -.->|"unknown"| RECOVER
    RECOVER -->|"Результат найден"| SAVE
    RECOVER -->|"Подтверждено отсутствие"| CHECK
    RECOVER -->|"Исход неясен"| OWNER["Сохранить unknown и запросить решение"]

flowchart TD
    A["Запрос пользователя или разрешённый запуск"] --> B{"Настройка и разрешения доступны?"}
    B -->|Нет| C{"Пользователь настраивает скилл?"}
    C -->|Да| S1["Проверить возможности; уточнить только недостающее"]
    C -->|Нет| LIMIT["Дать доступный результат или назвать конкретный блокер"]
    S1 --> S2["Показать программу; подключить выбранный дневник"]
    S2 --> S3["Сохранить личные настройки и независимую ссылку"]
    S3 --> S4["Включить только проверенные разрешённые функции"]
    S4 --> S5["Карточка готовности; блокировка затрагивает свою функцию"]
    B -->|Да| D{"Режим"}
    D -->|Настройка| S1
    D -->|Начать тренировку| T1["Прочитать план и три последних подтверждённых занятия"]
    T1 --> T2["Учесть фактические веса, объём, перерывы и сохранённое восстановление"]
    T2 --> T3{"Есть боль или риск?"}
    T3 -->|Да| T4["Уточнить безопасность; остановить болезненное движение; медицинская помощь при показаниях"]
    T3 -->|Нет| T5["Адаптировать программу; план и факт разделить"]
    T5 --> T6{"Есть поддерживаемый виджет?"}
    T6 -->|Да| T7["Программа и форма; без проверенного сохранения ввод лишь черновик"]
    T6 -->|Нет| T8["Программа и дневник текстом или таблицей"]
    T7 --> J1
    T8 --> J1
    D -->|Результаты или исправление| J1["Получить подтверждённый факт; прочитать существующую запись"]
    J1 --> J2["Сопоставить занятие и упражнения; сохранить изменения без дубля"]
    J2 --> J3["Перечитать и проверить; подтвердить только сохранённое"]
    D -->|Вечерний запуск| E1["Локальная дата; метаданные, план, кредитное состояние и строка дня"]
    E1 --> E2{"Дневник доступен и состояние проверено?"}
    E2 -->|Нет| E3["Блокер; без WHOOP-запросов"]
    E2 -->|Да| E4{"Строка уже complete или partial?"}
    E4 -->|Да| E5["Завершить без повторного сбора"]
    E4 -->|Нет| E6{"Есть резерв, attempted или unknown?"}
    E6 -->|Да| E7["Сверить сохранённое; восстановить данные; не повторять предпринятое"]
    E6 -->|Нет| E8{"Кредиты заблокированы?"}
    E8 -->|Да| E9["Ожидать подтверждённого сброса; не повторять уведомление"]
    E8 -->|Нет| EX{"Исключительное владение сбором проверено?"}
    EX -->|Нет| E3
    EX -->|Да| E10["Резерв строки с run ID; read-back; конфликт означает остановку"]
    E10 --> E11["Для очередного из трёх запросов: сохранить attempted"]
    E11 --> E12["Один прямой IFTTT-вызов: Recovery, Sleep или Strain"]
    E12 --> E13{"Лимит кредитов исчерпан?"}
    E13 -->|Да| E14["Сохранить блокировку; один раз сообщить; остановить оставшиеся"]
    E13 -->|Нет| E15["Сразу сохранить результат или error/unknown; не повторять"]
    E15 --> E16{"Сохранение подтверждено?"}
    E16 -->|Нет| E17["Результат в разрешённый постоянный чат; сообщить о сбое; остановить сбор"]
    E16 -->|Да| E18{"Есть ещё не предпринятый запрос?"}
    E18 -->|Да| E11
    E18 -->|Нет| E19["Оценить план и факт; свежесть; ккал из кДж; ориентир на завтра"]
    E14 --> E19
    E19 --> E20["Сохранить complete, partial или blocked; проверить значения и отсутствие дубля"]
    E20 --> E21["Краткий итог со ссылкой в постоянный канал задачи"]
